{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Check: TypeScript",
      "type": "shell",
      "command": "npm run type",
      "options": {
        "cwd": "${workspaceFolder}/web-react"
      },
      "presentation": {
        "reveal": "never",
        "panel": "shared"
      },
      "problemMatcher": "$tsc"
    },
    {
      "label": "Check: ESLint",
      "type": "shell",
      "command": "npm run eslint",
      "options": {
        "cwd": "${workspaceFolder}/web-react"
      },
      "presentation": {
        "reveal": "never",
        "panel": "shared"
      },
      "problemMatcher": "$eslint-stylish"
    },
    {
      "label": "Check: Stylelint",
      "type": "shell",
      "command": "npm run stylelint -- --formatter=unix",
      "options": {
        "cwd": "${workspaceFolder}/web-react"
      },
      "presentation": {
        "reveal": "never",
        "panel": "shared"
      },
      "problemMatcher": "$stylelint-unix"
    },
    {
      "label": "Check workspace",
      "dependsOn": [
        "Check: TypeScript",
        "Check: ESLint",
        "Check: Stylelint"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": [ ],
      "runOptions": {
        "runOn": "folderOpen"
      }
    }
  ]
}