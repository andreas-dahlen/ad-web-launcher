{
  "eslint.workingDirectories": [
    {
      "directory": "./web-react",
      "changeProcessCWD": true
    }
  ],
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
    "json",
    "jsonc"
  ],
  "json.schemas": [
    {
      "fileMatch": [
        "web-react/src/styleTokens/tokens/**/*.json",
        "web-react/src/styleTokens/tokens/**/*.jsonc"
      ],
      "url": "./web-react/src/styleTokens/schema/token.schema.json"
    }
  ],
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/android": true,
    "**/archive": true,
    "**/ADWebWallpaper": true,
    "**/md": true,
    "**/node_modules": true,
    "*/coverage": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/bower_components": true,
    "**/*.code-search": true
  },
  "css.customData": [
    "./.vscode/css-custom-data.json"
  ]

}