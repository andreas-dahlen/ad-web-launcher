{
  "eslint.workingDirectories": [
    {
      "directory": "./web-react",
      "changeProcessCWD": true
    }
  ],
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
    "json",
    "jsonc"
  ],
  "json.schemas": [
    {
      "fileMatch": [
        "web-react/src/styleTokens/tokens/**/*.json",
        "web-react/src/styleTokens/tokens/**/*.jsonc"
      ],
      "url": "./web-react/src/styleTokens/schema/token.schema.json"
    }
  ],
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/android": true,
    "**/archive": true,
    "**/ADWebWallpaper": true,
    "**/md": true,
    "**/node_modules": true,
    "*/coverage": true,
    ".git": true,
    ".github": true,
    ".gitignore": true,
    ".idea": true,
    ".vscode": true,
    "Debugbrowser": true,
    "README.md": true,
    "ad-web-launcher.code-workspace": true,
    "android": true,
    "archive": true,
    "md": true,
    "package-lock.json": true,
    "web-react/.env": true,
    "web-react/.env.production": true,
    "web-react/.gitignore": true,
    "web-react/.vscode": true,
    "web-react/Justfile": true,
    "web-react/README.md": true,
    "web-react/SRC_TREE.md": true,
    "web-react/analysis": true,
    "web-react/dist": true,
    "web-react/docs": true,
    "web-react/index.html": true,
    "web-react/knip.ts": true,
    "web-react/node_modules": true,
    "web-react/package-lock.json": true,
    "web-react/package.json": true,
    "web-react/plugins": true,
    "web-react/postcss.config.js": true,
    "web-react/scripts": true,
    "web-react/src": true,
    "web-react/stylelint.config.ts": true,
    "web-react/tsconfig.app.json": true,
    "web-react/tsconfig.json": true,
    "web-react/tsconfig.node.json": true,
    "web-react/tsconfig.paths.json": true,
    "web-react/vite-env.d.ts": true,
    "web-react/vite.compiler.ts": true,
    "web-react/vite.config.ts": true,
    "web-react/vitest.config.ts": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/bower_components": true,
    "**/*.code-search": true,
    ".git": false,
    ".github": false,
    ".gitignore": false,
    ".idea": false,
    ".vscode": false,
    "Debugbrowser": false,
    "README.md": false,
    "ad-web-launcher.code-workspace": false,
    "android": false,
    "archive": false,
    "md": false,
    "package-lock.json": false,
    "web-react/.env": false,
    "web-react/.env.production": false,
    "web-react/.gitignore": false,
    "web-react/.vscode": false,
    "web-react/Justfile": false,
    "web-react/README.md": false,
    "web-react/SRC_TREE.md": false,
    "web-react/analysis": false,
    "web-react/dist": false,
    "web-react/docs": false,
    "web-react/index.html": false,
    "web-react/knip.ts": false,
    "web-react/node_modules": false,
    "web-react/package-lock.json": false,
    "web-react/package.json": false,
    "web-react/plugins": false,
    "web-react/postcss.config.js": false,
    "web-react/scripts": false,
    "web-react/src": false,
    "web-react/stylelint.config.ts": false,
    "web-react/tsconfig.app.json": false,
    "web-react/tsconfig.json": false,
    "web-react/tsconfig.node.json": false,
    "web-react/tsconfig.paths.json": false,
    "web-react/vite-env.d.ts": false,
    "web-react/vite.compiler.ts": false,
    "web-react/vite.config.ts": false,
    "web-react/vitest.config.ts": false
  },
  "css.customData": [
    "./.vscode/css-custom-data.json"
  ]

}