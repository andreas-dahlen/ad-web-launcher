{
  "json.schemas": [
    {
      "fileMatch": [
        "web-react/src/styleTokens/tokens/**/*.{json,jsonc}"
      ],
      "url": "./web-react/src/styleTokens/schema/token.schema.json"
    }
  ],
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/android": true,
    "**/archive": true,
    "**/ADWebWallpaper": true,
    "**/md": true,
    "**/dist": true,
    "**/node_modules": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/bower_components": true,
    "**/*.code-search": true
  }
}