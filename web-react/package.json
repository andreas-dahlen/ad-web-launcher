{
  "name": "web-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:open": "xdg-open coverage/index.html",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:prod": "tsc -b && vite build --mode production && node scripts/deploy.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "knip": "knip",
    "tokens": "tsx src/styleTokens/compiler/dryLogCompiler.ts",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "clsx": "^2.1.1",
    "immer": "^11.1.8",
    "jsonc-parser": "^3.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite-plugin-svgr": "^5.2.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.1.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-json-schema-validator": "^6.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-unicorn": "^72.0.0",
    "globals": "^17.8.0",
    "jsdom": "^30.0.1",
    "jsonc-eslint-parser": "^3.1.0",
    "knip": "^6.31.0",
    "postcss": "^8.5.25",
    "postcss-selector-parser": "^7.1.4",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.7"
  },
  "allowScripts": {
    "@swc/core@1.15.40": true
  }
}
