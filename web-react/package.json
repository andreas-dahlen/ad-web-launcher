{
  "name": "web-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:open": "xdg-open coverage/index.html",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:prod": "tsc -b && vite build --mode production && node scripts/deploy.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "knip": "knip",
    "tokens": "tsx src/styleTokens/compiler/dryLogCompiler.ts",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "clsx": "^2.1.1",
    "immer": "^11.1.18",
    "jsonc-parser": "^3.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite-plugin-svgr": "^5.2.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/coverage-v8": "^4.1.11",
    "colorjs.io": "^0.7.1",
    "eslint": "^10.8.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-json-schema-validator": "^6.3.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "eslint-plugin-unicorn": "^73.0.0",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "jsonc-eslint-parser": "^3.3.0",
    "knip": "^6.32.2",
    "postcss": "^8.5.26",
    "postcss-selector-parser": "^7.1.5",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "@swc/core@1.15.46": true,
    "esbuild@0.28.1": true,
    "unrs-resolver@1.12.2": true
  }
}
