{
  "component": "svgIcon",
  "inFix": "svg",

  "alwaysAllowed": ["o", "p", "f"],
  "vars": {
    "mode-off-col": {"allowed": ["m"],"values": { "m": "f", "f": "var(--_col-neutral-light-1)" }},
    "mode-on-col": {"allowed": ["m"],"values": { "m": "f",  "f": "var(--_col-neutral-dark-1)" }},
    "mode-default-col": {"allowed": ["m"],"values": { "m": "f",  "f": "var(--_col-neutral-mid-1)" }},
    "mode-disabled-col": {"allowed": ["m"],"values": { "m": "f",  "f": "var(--_col-neutral-mid-1)" }},

    "width": {"values": {"p": "f", "f": "40px"}},
    "height": {"values": {"p": "f", "f": "40px"}},
    "flipX": {"name": "flip-x", "values": {"f": "scaleX(1)"}},
    "flipY": {"name": "flip-y", "values": {"f": "scaleY(1)"}},
    "rotate": {"values": {"f": "rotate(0deg)"}}
  }
}