{
  "required": [
    "component",
    "vars"
  ],

  "type": "object",
  "additionalProperties": false,
  "properties": {
    "component": {
      "type": "string",
      "description": "Component name: <component>.module.css"
    },
    "infix": {
      "type": "string",
      "description": "ClassName and infix."
    },
    "alwaysAllowed": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [ "o", "s", "m", "p", "t", "f" ]
      }
    },
    "vars": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/variable"
      }
    }
  },
  "$defs": {
    "variable": {
      "type": "object",
      "properties": {

        "name": {
          "type": "string"
        },

        "allowed": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [ "o", "s", "m", "p", "t", "f" ]
          }
        },

        "exclude": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [ "o", "s", "m", "p", "t", "f" ]
          }
        },

        "values": {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "o": { "type": "string" },
            "s": { "type": "string" },
            "m": { "type": "string" },
            "p": { "type": "string" },
            "t": { "type": "string" },
            "f": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}