{
  "component": "button",
  "infix": "button",

  "alwaysAllowed": ["o", "p", "f"],
  "vars": {
    "bg": {"allowed": ["t"],"values": {"f": "hotPink"}},

    "position": {"values": {"f": "relative"}},
    "display": {"values": {"f": "flex"}},
    "align": {"values": {"f": "center"}},
    "justify": {"values": {"f": "center"}},

    "width": {"values": {"f": "50px"}},
    "height": {"values": {"f": "50px"}},

    "radius": {"values": {"f": "var(--_border-radius-xs)"}},
    "border": {"values": {"f": "none"}},
    "shadow": {"values": {"f": "0px 0px 10px var(--_col-neutral-dark-1)"}},
    "opacity": {"values": {"f": "1"}},

    "statePressedScale": {"allowed": ["s"], "exclude":["p"], "values": {"f": "scale(0.98)"}},
    "stateReleasedScale": {"allowed": ["s"],"exclude":["p"],"values": {"f": "scale(1)"}},
    "stateCanceledScale": {"allowed": ["s"],"exclude":["p"],"values": {"f": "scale(1)"}},
    "stateCanceledOpacity": {"allowed": ["s"],"exclude":["p"], "values": {"f": "0.5"}},
    "statePressedFilter": {"allowed": ["s"],"exclude":["p"], "values": {"f": "brightness(0.95)"}}
  }
}