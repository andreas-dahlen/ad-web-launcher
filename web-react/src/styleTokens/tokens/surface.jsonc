    // "height": { "values": { "f": "auto"}},

    "gap": { "values": {"f": "0"} },
    "margin": { "values": {"f": "0"}},
    "padding": { "values": {"f": "0px"} },

    "border": { "allowed": ["t"], "values": {"f": "none"}},
    "radius":{"values": {"f": "0px"}},
    "shadow": { "values": { "f": "none"}},
    "blur": { "values": { "f": "none"}},

    "beforeContent": {"values": { "f": "none"}},
    "opacity": {"values": {"f": "1"}}
