{
  "name": "cascade",
  "version": "0.0.1",
  "type": "module",
  "bin": {
    "cascade": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/public/index.d.ts",
      "import": "./dist/public/index.js",
      "default": "./dist/public/index.js"
    },
    "./generated": {
      "types": "./generated/index.d.ts",
      "import": "./generated/index.js",
      "default": "./generated/index.js"
    },
    "./vite": {
      "types": "./dist/public/vite.d.ts",
      "import": "./dist/public/vite.js",
      "default": "./dist/public/vite.js"
    }
  },
  "scripts": {
    "coverage": "vitest run --coverage",
    "test": "vitest",
    "type": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "cli": "npm run build && node dist/cli.js"
  },
  "peerDependencies": {
    "vite": "^8.2.2"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },

  "dependencies": {
    "chokidar": "^5.0.0",
    "colorjs.io": "^0.7.1",
    "jsonc-parser": "^3.3.1",
    "postcss": "^8.5.26",
    "postcss-selector-parser": "^7.1.5",
    "zod": "^4.5.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^5.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0",
    "vite": "^8.2.2"
  },
  "allowScripts": {
    "@vitest/coverage-v8@5.0.0": true,
    "vitest@5.0.0": true
  }
}
