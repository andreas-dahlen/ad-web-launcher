{
  "publisher": "ad-web-launcher",
  "name": "slice-maps",
  "type": "module",
  "displayName": "Slice Maps",
  "description": "Create slices of workspace folders and files for easier navigation.",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "coverage": "vitest run --coverage",
    "test": "vitest",
    "type": "tsc --noEmit",
    "build": "tsc --noEmit -p tsconfig.src.json && esbuild src/extension.ts --bundle --platform=node --format=esm --external:vscode --main-fields=module,main --outfile=dist/extension.js",
    "package": "npm run build && vsce package --allow-missing-repository"
  },
  "dependencies": {
    "find-up": "^8.0.0",
    "jsonc-parser": "^3.3.1",
    "picomatch": "^4.0.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/picomatch": "^4.0.3",
    "@types/vscode": "^1.134.0",
    "@vitest/coverage-v8": "^5.0.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "keytar@7.9.0": true,
    "@types/vscode@1.125.0": true,
    "@vscode/vsce-sign@2.1.0": true
  },
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "sliceMaps",
          "name": "Slice Maps",
          "icon": "resources/slice-maps.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "sliceMaps.activate",
        "title": "Activate Slice Map"
      },
      {
        "command": "sliceMaps.create",
        "title": "Create Slice Map"
      },
      {
        "command": "sliceMaps.rename",
        "title": "Rename Slice Map"
      },
      {
        "command": "sliceMaps.delete",
        "title": "Delete Slice Map"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "sliceMaps.rename",
          "when": "view == sliceMaps && viewItem == sliceMap"
        },
        {
          "command": "sliceMaps.delete",
          "when": "view == sliceMaps && viewItem == sliceMap"
        }
      ],
      "view/title": [
        {
          "command": "sliceMaps.create",
          "when": "view == sliceMaps",
          "group": "navigation"
        }
      ]
    }
  }
}
