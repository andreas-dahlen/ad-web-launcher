{
  "publisher": "ad-web-launcher",
  "name": "slice-maps",
  "type": "module",
  "displayName": "Slice Maps",
  "description": "Create slices of workspace folders and files for easier navigation.",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "coverage": "vitest run --coverage",
    "test": "vitest",
    "type": "tsc --noEmit",
    "build": "tsc --noEmit -p tsconfig.src.json && esbuild src/extension.ts --bundle --platform=node --format=esm --external:vscode --main-fields=module,main --outfile=dist/extension.js",
    "package": "npm run build && vsce package --allow-missing-repository"
  },
  "dependencies": {
    "find-up": "^8.0.0",
    "jsonc-parser": "^3.3.1",
    "picomatch": "^4.0.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/picomatch": "^4.0.3",
    "@types/vscode": "^1.134.0",
    "@vitest/coverage-v8": "^5.0.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "keytar@7.9.0": true,
    "@types/vscode@1.125.0": true,
    "@vscode/vsce-sign@2.1.0": true
  },
  "contributes": {
    "configuration": {
      "properties": {
        "sliceMaps.behavior": {
          "type": "string",
          "default": "recursive",
          "enum": [ "recursive", "preserve" ],
          "enumDescriptions": [
            "Including or excluding a folder recursively overrides the configuration of its children.",
            "Including or excluding a folder preserves the existing configuration of its children."
          ],
          "description": "Controls how folder inclusion and exclusion affect descendant configuration." },
        "sliceMaps.traversalStoppers": {
          "type": "array",
          "items": { "type": "string" },
          "default": [ ".git", ".svn", ".vs", ".vscode", ".cache", "__pycache__", "node_modules", "dist", "packages", "build", "target", "Release", "Debug", "bin", "obj" ],
          "description": "Exclude folders that are not traversed by sliceMaps." }
      }
    },

    "viewsContainers": {
      "activitybar": [
        {
          "id": "sliceMapsContainer",
          "title": "Slice Maps",
          "icon": "resources/slice-maps.svg"
        }
      ]
    },

    "views": {
      "explorer": [
        { "id": "sliceMaps",
          "name": "Slice",
          "icon": "resources/slice-maps.svg" }
      ],
      "sliceMapsContainer": [
        {
          "id": "sliceWorkspace",
          "name": "Workspace",
          "icon": "resources/slice-maps.svg"
        },
        {
          "id": "sliceMapsWorkspace",
          "name": "Slice",
          "icon": "resources/slice-maps.svg"
        }
      ]
    },
    "commands": [
      { "command": "sliceMaps.configure", "title": "Configure Slice Item", "icon": "$(gear)" },
      { "command": "sliceMaps.deactivateAll", "title": "Deactivate All", "icon": "$(clear-all)" },
      { "command": "sliceMaps.missingConfig", "title": "Set Up Slice Maps" },
      { "command": "sliceMaps.toggle", "title": "Toggle Slice" },
      { "command": "sliceMaps.create", "title": "Create Slice", "icon": "$(add)" },
      { "command": "sliceMaps.rename", "title": "Rename Slice" },
      { "command": "sliceMaps.delete", "title": "Delete Slice" },
      { "command": "sliceMaps.include", "title": "Include in Slice" },
      { "command": "sliceMaps.exclude", "title": "Exclude from Slice" },
      { "command": "sliceMaps.reset", "title": "Reset Slice" },
      { "command": "sliceMaps.createFilter", "title": "Create Filter", "icon": "$(add)" },
      { "command": "sliceMaps.toggleFilter", "title": "Toggle Filter" },
      { "command": "sliceMaps.renameFilter", "title": "Rename Filter" },
      { "command": "sliceMaps.deleteFilter", "title": "Delete Filter" },
      { "command": "sliceMaps.resetFilter", "title": "Reset Filter" },
      { "command": "sliceMaps.removeExcludeFilter", "title": "Remove Exclude Filter" },
      { "command": "sliceMaps.addExcludeFilter", "title": "Add Exclude Filter" },
      { "command": "sliceMaps.glob", "title": "Add Glob Exclusion" },
      { "command": "sliceMaps.compressPreserved", "title": "Compress Redundant Rules", "icon": "$(sync)" },
      { "command": "sliceMaps.includeWorkspace", "title": "Include in Slice (Workspace)", "icon": "$(add)" },
      { "command": "sliceMaps.excludeWorkspace", "title": "Exclude from Slice (Workspace)", "icon": "$(circle-slash)" },
      { "command": "sliceMaps.removeExcludeFilterWorkspace", "title": "Remove Exclude Filter (Workspace)", "icon": "$(diff-removed)" },
      { "command": "sliceMaps.addExcludeFilterWorkspace", "title": "Add Exclude Filter (Workspace)", "icon": "$(diff-added)" },
      { "command": "sliceMaps.missingConfigWorkspace", "title": "Set Up Slice Maps (Workspace)", "icon": "$(heart)" }
    ],

    "keybindings": [
      { "command": "sliceMaps.include", "key": "alt+d",
        "when": "filesExplorerFocus  && sliceMaps.activeType == map" },

      { "command": "sliceMaps.removeExcludeFilter", "key": "alt+d",
        "when": "filesExplorerFocus  && sliceMaps.activeType == filter" },

      { "command": "sliceMaps.exclude", "key": "alt+s",
        "when": "filesExplorerFocus  && sliceMaps.activeType == map" },

      { "command": "sliceMaps.addExcludeFilter", "key": "alt+s",
        "when": "filesExplorerFocus  && sliceMaps.activeType == filter" },



      { "command": "sliceMaps.includeWorkspace", "key": "alt+d",
        "when": "focusedView == sliceWorkspace && sliceMaps.activeType == map" },

      { "command": "sliceMaps.removeExcludeFilterWorkspace", "key": "alt+d",
        "when": "focusedView == sliceWorkspace && sliceMaps.activeType == filter" },

      { "command": "sliceMaps.excludeWorkspace", "key": "alt+s",
        "when": "focusedView == sliceWorkspace && sliceMaps.activeType == map" },

      { "command": "sliceMaps.addExcludeFilterWorkspace", "key": "alt+s",
        "when": "focusedView == sliceWorkspace && sliceMaps.activeType == filter" }
    ],

    "menus": {
      "explorer/context": [
        { "command": "sliceMaps.include",
          "when": "resourceScheme == file && sliceMaps.activeType == map" },

        { "command": "sliceMaps.exclude",
          "when": "resourceScheme == file && sliceMaps.activeType == map" },

        { "command": "sliceMaps.removeExcludeFilter",
          "when": "resourceScheme == file && sliceMaps.activeType == filter" },

        { "command": "sliceMaps.addExcludeFilter",
          "when": "resourceScheme == file && sliceMaps.activeType == filter" },

        { "command": "sliceMaps.missingConfig",
          "when": "resourceScheme == file && !sliceMaps.activeType" }
      ],

      "view/item/context": [
        { "command": "sliceMaps.includeWorkspace",
          "when": "view == sliceWorkspace && viewItem == workspaceFile && sliceMaps.activeType == map" },
        { "command": "sliceMaps.includeWorkspace",
          "when": "view == sliceWorkspace && viewItem == workspaceFile && sliceMaps.activeType == map", "group": "inline" },

        { "command": "sliceMaps.excludeWorkspace",
          "when": "view == sliceWorkspace && viewItem == workspaceFile && sliceMaps.activeType == map" },
        { "command": "sliceMaps.excludeWorkspace",
          "when": "view == sliceWorkspace && viewItem == workspaceFile && sliceMaps.activeType == map", "group": "inline" },

        { "command": "sliceMaps.removeExcludeFilterWorkspace",
          "when": "view == sliceWorkspace && viewItem == workspaceFile && sliceMaps.activeType == filter" },
        { "command": "sliceMaps.removeExcludeFilterWorkspace",
          "when": "view == sliceWorkspace && viewItem == workspaceFile && sliceMaps.activeType == filter", "group": "inline" },

        { "command": "sliceMaps.addExcludeFilterWorkspace",
          "when": "view == sliceWorkspace && viewItem == workspaceFile && sliceMaps.activeType == filter" },
        { "command": "sliceMaps.addExcludeFilterWorkspace",
          "when": "view == sliceWorkspace && viewItem == workspaceFile && sliceMaps.activeType == filter", "group": "inline" },

        { "command": "sliceMaps.missingConfigWorkspace",
          "when": "view == sliceWorkspace && viewItem == workspaceFile && !sliceMaps.activeType" },
        { "command": "sliceMaps.missingConfigWorkspace",
          "when": "view == sliceWorkspace && viewItem == workspaceFile && !sliceMaps.activeType", "group": "inline" },



        { "command": "sliceMaps.create",
          "when": "(view == sliceMaps || view == sliceMapsWorkspace) && viewItem == sliceMapGroup" },
        { "command": "sliceMaps.create",
          "when": "(view == sliceMaps || view == sliceMapsWorkspace) && viewItem == sliceMapGroup", "group": "inline" },

        { "command": "sliceMaps.createFilter",
          "when": "(view == sliceMaps || view == sliceMapsWorkspace) && viewItem == sliceFilterGroup" },
        { "command": "sliceMaps.createFilter",
          "when": "(view == sliceMaps || view == sliceMapsWorkspace) && viewItem == sliceFilterGroup", "group": "inline" },

        { "command": "sliceMaps.configure",
          "when": "(view == sliceMaps || view == sliceMapsWorkspace) && (viewItem == sliceMap || viewItem == sliceFilter)",
          "group": "inline" },

        { "command": "sliceMaps.rename",
          "when": "(view == sliceMaps || view == sliceMapsWorkspace) && viewItem == sliceMap" },

        { "command": "sliceMaps.delete",
          "when": "(view == sliceMaps || view == sliceMapsWorkspace) && viewItem == sliceMap" },

        { "command": "sliceMaps.reset",
          "when": "(view == sliceMaps || view == sliceMapsWorkspace) && viewItem == sliceMap" },

        { "command": "sliceMaps.renameFilter",
          "when": "(view == sliceMaps || view == sliceMapsWorkspace) && viewItem == sliceFilter" },

        { "command": "sliceMaps.deleteFilter",
          "when": "(view == sliceMaps || view == sliceMapsWorkspace) && viewItem == sliceFilter" },

        { "command": "sliceMaps.resetFilter",
          "when": "(view == sliceMaps || view == sliceMapsWorkspace) && viewItem == sliceFilter" },


        { "command": "sliceMaps.glob",
          "when": "(view == sliceMaps || view == sliceMapsWorkspace) && sliceMaps.activeType && (viewItem == sliceMap || viewItem == sliceFilter)" }

      ],
      "view/title": [
        {
          "command": "sliceMaps.compressPreserved",
          "when": "view == sliceMaps || view == sliceMapsWorkspace",
          "group": "navigation"
        },
        {
          "command": "sliceMaps.deactivateAll",
          "when": "view == sliceMaps || view == sliceMapsWorkspace",
          "group": "navigation"
        }
      ]
    }
  }
}
