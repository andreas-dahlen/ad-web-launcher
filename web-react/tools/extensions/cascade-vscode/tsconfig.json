{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "lib": [ "ESNext" ],
    "types": [ "node", "vscode" ],

    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,

    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,

    "rootDir": "src",
    "outDir": "dist",

    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [ "src/**/*.ts" ]
}