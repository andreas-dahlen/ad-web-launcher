{
  "publisher": "ad-web-launcher",
  "name": "css-variable-completion",
  "type": "module",
  "displayName": "CSS Variable Completion",
  "description": "Provides completion for CSS custom-property declarations.",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:css",
    "onLanguage:scss",
    "onLanguage:less"
  ],
  "scripts": {
    "coverage": "vitest run --coverage",
    "test": "vitest",
    "type": "tsc --noEmit",
    "knip": "knip",
    "build": "tsc && esbuild src/extension.ts --bundle --platform=node --format=esm --external:vscode --main-fields=module,main --outfile=dist/extension.js",
    "package": "npm run build && vsce package --allow-missing-repository"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/vscode": "^1.134.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3",
    "knip": "^6.32.2",
    "vitest": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "keytar@7.9.0": true,
    "@types/vscode@1.125.0": true,
    "@vscode/vsce-sign@2.1.0": true
  },
  "contributes": {
    "configuration": {
      "properties": {
        "cssVariableCompletion.variablesFile": {
          "type": "string",
          "default": "web-react/src/styleTokens/generated/metadata/extension.generated.jsonc",
          "description": "Path to the CSS variable metadata file, relative to the workspace."
        },
        "cssVariableCompletion.lspFile": {
          "type": "string",
          "default": "web-react/src/styleTokens/generated/metadata/lsp.generated.ts",
          "description": "Path to the LSP variable metadata file, relative to the workspace."
        }
      }
    }
  }
}
