{
  "publisher": "ad-web-launcher",
  "name": "match-completion",
  "type": "module",
  "displayName": "Match Completion",
  "description": "Provides completion suggestions when text matches a configured pattern.",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "coverage": "vitest run --coverage",
    "test": "vitest",
    "type": "tsc --noEmit",
    "build": "tsc --noEmit -p tsconfig.src.json && esbuild src/extension.ts --bundle --platform=node --format=esm --external:vscode --main-fields=module,main --outfile=dist/extension.js",
    "package": "npm run build && vsce package --allow-missing-repository"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "micromatch": "^4.0.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/vscode": "^1.134.0",
    "@vitest/coverage-v8": "^5.0.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "keytar@7.9.0": true,
    "@types/vscode@1.125.0": true,
    "@vscode/vsce-sign@2.1.0": true
  },
  "contributes": {
    "configuration": {
      "properties": {
        "matchCompletion.suggestions": {
          "type": "object",
          "default": {
            "//": [
              "NOTE",
              "QUEST"
            ]
          },
          "description": "Maps text patterns to completion suggestions."
        },
        "matchCompletion.snippetBindings": {
          "type": "array",
          "default": [
            "ö",
            "asd"
          ],
          "description": "Text prefixes that trigger snippet suggestions."
        },
        "matchCompletion.snippetPath": {
          "type": "string",
          "default": ".vscode/ad-web.code-snippets",
          "description": "Path to a snippet file."
        },
        "matchCompletion.languages": {
          "type": "array",
          "default": [
            "typescript",
            "javascript"
          ],
          "description": "Language identifiers where match completion is enabled."
        }
      }
    }
  }
}
