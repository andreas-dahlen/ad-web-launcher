{
  "publisher": "ad-web-launcher",
  "name": "token-compiler-vscode",
  "type": "module",
  "displayName": "Token Compiler",
  "description": "Integrates the Token Compiler with VS Code.",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "coverage": "vitest run --coverage",
    "test": "vitest",
    "type": "tsc --noEmit",
    "build": "tsc && esbuild src/extension.ts --bundle --platform=node --format=esm --external:vscode --main-fields=module,main --outfile=dist/extension.js",
    "package": "npm run build && vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/vscode": "^1.134.0",
    "@vitest/coverage-v8": "^5.0.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@types/vscode@1.125.0": true,
    "keytar@7.9.0": true,
    "@vscode/vsce-sign@2.1.0": true,
    "@vitest/coverage-v8@5.0.0": true,
    "vitest@5.0.0": true
  },
  "contributes": {
    "configuration": {
      "properties": {
        "tokenCompilerVscode.tokenFolder": {
          "type": "string",
          "description": "Path to the tokens folder, relative to the project root."
        },
        "tokenCompilerVscode.outDir": {
          "type": "string",
          "description": "Path to generated output, relative to the project root."
        },
        "tokenCompilerVscode.cliFile": {
          "type": "string",
          "default": "tools/token-compiler/dist/cli.js",
          "description": "Path to the compiler CLI, relative to the project root."
        },
        "tokenCompilerVscode.projectRoot": {
          "type": "string",
          "default": ".",
          "description": "Path to the project root, relative to the workspace."
        },
        "tokenCompilerVscode.mute": {
          "type": "boolean",
          "default": true,
          "description": "Removes verbose compiler output messages."
        }
      }
    },
    "configurationDefaults": {
      "files.associations": {
        "compiler.config.json": "jsonc"
      }
    },
    "commands": [
      {
        "command": "tokenCompilerVscode.start",
        "title": "Token Compiler: Start"
      },
      {
        "command": "tokenCompilerVscode.stop",
        "title": "Token Compiler: Stop"
      },
      {
        "command": "tokenCompilerVscode.restart",
        "title": "Token Compiler: Restart"
      }
    ]
  }
}
