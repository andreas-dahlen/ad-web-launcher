{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "verbatimModuleSyntax": true,

    "lib": [ "ES2023" ],
    "types": [ "node" ],

    "strict": true,
    "skipLibCheck": true,

    "rootDir": "src",
    "outDir": "dist",
    "noEmit": false,

    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [ "src/**/*.ts" ],
  "exclude": [ "src/test" ]
}