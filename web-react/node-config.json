{
    "compilerOptions": {
        "paths": {
            "@api/*": [
                "./src/api/*"
            ],
            "@app/*": [
                "./src/app/*"
            ],
            "@assets/*": [
                "./src/assets/*"
            ],
            "@blocks/*": [
                "./src/blocks/*"
            ],
            "@composites/*": [
                "./src/composites/*"
            ],
            "@config/*": [
                "./src/config/*"
            ],
            "@data/*": [
                "./src/data/*"
            ],
            "@features/*": [
                "./src/features/*"
            ],
            "@interaction/*": [
                "./src/interaction/*"
            ],
            "@panels/*": [
                "./src/panels/*"
            ],
            "@primitives/*": [
                "./src/primitives/*"
            ],
            "@shared/*": [
                "./src/shared/*"
            ],
            "@stores/*": [
                "./src/shared/state/stores/*"
            ],
            "@hooks/*": [
                "./src/shared/state/hooks/*"
            ],
            "@typing/*": [
                "./src/shared/typing/*"
            ],
            "@styles/*": [
                "./src/shared/styles/*"
            ],
            "@generated/*": [
                "./src/shared/generated/*"
            ],
            "@styleCompiler/*": [
                "./src/styleCompiler/*"
            ],
            "@schema/*": [
                "./src/styleCompiler/schema/*"
            ],
            "@test/*": [
                "./src/test/*"
            ]
        },
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
        "composite": true,
        "target": "es2023",
        "lib": [
            "es2023"
        ],
        "module": "esnext",
        "types": [
            "node"
        ],
        "skipLibCheck": true,
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "moduleDetection": "force",
        "noEmit": true,
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "erasableSyntaxOnly": true,
        "noFallthroughCasesInSwitch": true,
        "noUncheckedSideEffectImports": true,
        "isolatedModules": true,
        "declaration": true,
        "preserveConstEnums": true,
        "incremental": true
    },
    "files": [
        "./vite.config.ts",
        "./plugins/token-report-state.ts",
        "./plugins/vite.plugin-jsonc.ts",
        "./plugins/vite.token-report.ts",
        "./plugins/vite.token-watcher.ts",
        "./src/shared/compilerUtils/compiler.types.ts",
        "./src/shared/compilerUtils/getAllowedPrefixes.ts",
        "./src/shared/compilerUtils/mergeJson.ts",
        "./src/shared/compilerUtils/normalizeCssValue.ts",
        "./src/shared/compilerUtils/prefixes.ts",
        "./src/shared/compilerUtils/resolveTokenOwnerName.ts",
        "./src/shared/compilerUtils/stringFormaters.ts",
        "./src/styleCompiler/loaders/findTokenFiles.ts",
        "./src/styleCompiler/loaders/loadTokenFile.ts",
        "./src/styleCompiler/schema/convert.ts",
        "./src/styleCompiler/tokens/slider/index.ts"
    ],
    "include": [
        "vite.config.ts",
        "plugins/**/*.ts",
        "src/shared/compilerUtils/**/*.ts",
        "src/styleCompiler/**/*.ts"
    ]
}
