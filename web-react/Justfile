# ==================== SETTINGS ====================

set shell := ["bash", "-c"]

workspace := "../ad-web-launcher.code-workspace"

# ================== DEFAULT ====================

default: help

# ================== DEVELOPMENT ====================

install:
    npm install

dev:
    npm run dev

build:
    npm run build

build-prod:
    vite build --mode production
    node scripts/deploy.js

preview:
    npm run preview

# ==================== QUALITY ====================

test *args:
    if [ -z "{{ args }}" ]; then \
        npm run test; \
    else \
        npm run test -- {{ args }}; \
    fi

coverage *args:
    if [ -z "{{ args }}" ]; then \
        npm run test:coverage; \
    else \
        npm run test:coverage -- {{ args }}; \
    fi

lint *args:
    if [ -z "{{ args }}" ]; then npm run lint; else npx eslint {{ args }}; fi

eslint: lint

knip:
    npx knip --no-exit-code

# ============== STYLE TOKENS LOG ==================

tokens *args:
    if [ -z "{{ args }}" ]; then npx tsx src/styleTokens/compiler/dryLogCompiler.ts; else npx tsx src/styleTokens/compiler/dryLogCompiler.ts {{ args }}; fi

# ==================== EXTENSIONS ====================

deploy-cvc:
    cd extensions/css-variable-completion && npm run deploy
    code --install-extension extensions/css-variable-completion/css-variable-completion-0.0.1.vsix

# ==================== WORKSPACE ====================

open:
    @echo "🤖 Opening workspace from WSL..."
    code {{ workspace }}

open-new:
    @echo "🤖 Opening workspace in a new window..."
    code -n {{ workspace }}


# ==================== HELP ====================

help:
    @echo ""
    @echo "==================== COMMAND SURFACE ===================="
    @echo ""
    @echo "[JUST] orchestration layer"
    @echo "→ just"
    @just --list
    @echo ""
    @echo "[NPM] package scripts"
    @echo "→ npm run"
    @npm pkg get scripts
