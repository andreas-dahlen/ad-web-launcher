# ==================== SETTINGS ====================

set shell := ["bash", "-c"]

workspace := "ad-web-launcher.code-workspace"

# ================== DEFAULT ====================

default: help

# ================== DEVELOPMENT ====================
audit *args:
    if [ -z "{{ args }}" ]; then \
        npm audit; \
    else \
        ./scripts/run-project.sh audit {{ args }}; \
    fi

audit-all:
    ./scripts/run-all.sh audit

outdated *args:
    if [ -z "{{ args }}" ]; then \
        npm outdated; \
    else \
        ./scripts/run-project.sh outdated {{ args }}; \
    fi

outdated-all:
    ./scripts/run-all.sh outdated || true

doctor *args:
    if [ -z "{{ args }}" ]; then \
        npm doctor; \
    else \
        ./scripts/run-project.sh doctor {{ args }}; \
    fi

doctor-all:
    ./scripts/run-all.sh doctor

install *args:
    if [ -z "{{ args }}" ]; then \
        npm install; \
    else \
        ./scripts/run-project.sh install {{ args }}; \
    fi

install-all:
    ./scripts/run-all.sh install
    ./scripts/run-all.sh install-scripts ls

update-all:
    ./scripts/run-all.sh update
    ./scripts/run-all.sh install-scripts ls

install-force *args:
    ./scripts/install-force.sh {{ args }}

install-force-all +packages:
    ./scripts/install-force-all.sh {{ packages }}

dev:
    npm run dev

preview:
    npm run preview

build *args:
    if [ -z "{{ args }}" ]; then \
        npm run build && ./scripts/deploy-android.sh; \
    else \
        ./scripts/run-project.sh run build {{ args }}; \
    fi

build-all:
    ./scripts/run-all.sh run build

# ==================== QUALITY ====================

type *args:
    if [ -z "{{ args }}" ]; then \
        npm run type; \
    else \
        ./scripts/run-project.sh run type {{ args }}; \
    fi    

type-all: 
    ./scripts/run-all.sh run type

test *args:
    if [ -z "{{args}}" ]; then \
        npm run test -- --config=vitest.config.ts --silent ; \
    else \
        ./scripts/run-project.sh run test {{args}} --silent ; \
    fi

test-all *args:
    npm run test -- --config=vitest.all.config.ts --silent=passed-only --reporter=dot {{args}}

# List available Vitest projects.
project-help:
    ./scripts/project-names.sh

coverage *args:
    if [ -z "{{args}}" ]; then \
        npm run test -- --config=vitest.config.ts --silent=passed-only --coverage; \
    else \
        ./scripts/run-project.sh run test {{args}} --silent=passed-only --coverage ; \
    fi

coverage-all:
    just test-all --coverage

coverage-open:
    xdg-open coverage/index.html

lint *args:
    if [ -z "{{ args }}" ]; then \
        npm run lint; \
    else \
        ./scripts/lint.sh {{ args }}; \
    fi

stylelint *args:
    if [ -z "{{ args }}" ]; then \
        npm run stylelint; \
    else \
        npx stylelint {{ args }}; \
    fi

eslint *args:
    npx eslint {{ args }}

oxlint *args:
    npx oxlint {{ args }}

style: stylelint

ox: oxlint

es: eslint

knip *args:
    npm run knip -- {{ args }}

# chmod +x scripts/index.sh <- an example for enabling a script

# ==================== EXTENSIONS ====================

# Builds and installs css-variable-completion (includes css-lsp helper).
install-cvc:
    cd tools/extensions/css-variable-completion && npm run package
    code --install-extension tools/extensions/css-variable-completion/css-variable-completion-0.0.1.vsix --force

# Builds and installs project-lint.
install-pl:
    cd tools/extensions/project-lint && npm run package
    code --install-extension tools/extensions/project-lint/project-lint-0.0.1.vsix --force

# Builds compiler and installs the compiler extension.
install-tokens:
    cd tools/cascade-compiler && npm run build
    cd tools/extensions/cascade-vscode && npm run package
    code --install-extension tools/extensions/cascade-vscode/cascade-vscode-0.0.1.vsix --force

# Builds and installs all tools.
install-extensions: install-cvc install-pl install-tokens

# Runs the compiler in watchMode. File emissions disabled.
compiler:
    cd tools/cascade-compiler && npm run cli -- watch ../..

all: build-all install-extensions

# ==================== WORKSPACE ====================

open:
    @echo "🤖 Opening workspace from WSL..."
    code {{ workspace }}

open-new:
    @echo "🤖 Opening workspace in a new window..."
    code -n {{ workspace }}

# ==================== DELETABLES ====================

# Check whether the current TypeScript version is supported by typescript-eslint
check-ts-v:
    npm view typescript-eslint@latest peerDependencies
    npm view @typescript-eslint/parser@latest peerDependencies

# Lists the dependencies of project versus tools. Takes dependency as args.
check-deps *args:
    scripts/dependencies.sh {{ args }}

    
# ==================== HELP ====================

help:
    @echo ""
    @echo "==================== COMMAND SURFACE ===================="
    @echo ""
    @echo "[JUST] orchestration layer"
    @echo "→ just"
    @just --list
    @echo ""
    @echo "[NPM] package scripts"
    @echo "→ npm run"
    @npm pkg get scripts
