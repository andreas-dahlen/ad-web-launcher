# ==================== SETTINGS & VARIABLES ====================
# Force bash to execute the commands cleanly inside WSL
set shell := ["bash", "-c"]

# Path to the workspace file relative to this web-react folder
workspace := "../ad-web-launcher.code-workspace"


# ==================== RECIPES ====================
# Runs help on just
default: help

install:
    npm install

dev:
    npm run dev

test *args:
    if [ -z "{{args}}" ]; then \
        npm run test; \
    else \
        npm run test -- {{args}}; \
    fi

lint *args:
    if [ -z "{{args}}" ]; then npm run lint; else npx eslint {{args}}; fi

eslint: lint

knip:
    npx knip --no-exit-code

tokens *args:
    if [ -z "{{args}}" ]; then npx tsx src/styleTokens/compiler/dryLogCompiler.ts; else npx tsx src/styleTokens/compiler/dryLogCompiler.ts {{args}}; fi

build:
    npm run build

build-prod:
    vite build --mode production
    node scripts/deploy.js

preview:
    npm run preview

# Open the parent folder's VS Code workspace file from WSL
open:
    @echo "🤖 Opening workspace from WSL..."
    code {{workspace}}

# Optional: Open the workspace in a totally new VS Code window
open-new:
    @echo "🤖 Opening workspace in a new window..."
    code -n {{workspace}}

help:
    @echo ""
    @echo "==================== COMMAND SURFACE ===================="
    @echo ""
    @echo "[JUST] orchestration layer"
    @echo "→ just"
    @just --list
    @echo ""
    @echo "[NPM] legacy script layer"
    @echo "→ npm run"
    @npm pkg get scripts