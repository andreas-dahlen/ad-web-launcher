# ==================== SETTINGS ====================

set shell := ["bash", "-c"]

workspace := "../ad-web-launcher.code-workspace"

# ================== DEFAULT ====================

default: help

# ================== DEVELOPMENT ====================

audit:
    npm audit

outdated:
    npm outdated

doctor:
    npm doctor

install:
    npm install

dev:
    npm run dev

build:
    npm run build

build-prod:
    vite build --mode production
    node scripts/deploy.js

preview:
    npm run preview

# ==================== QUALITY ====================

type:
    npm run typecheck

test *args:
    if [ -z "{{ args }}" ]; then \
        npm run test; \
    else \
        npm run test -- "src/test/{{ args }}"; \
    fi

coverage *args:
    if [ -z "{{ args }}" ]; then \
        npm run test:coverage; \
    else \
        npm run test:coverage -- "src/test/{{ args }}"; \
    fi

coverage-open:
    npm run test:coverage:open

lint *args:
    if [ -z "{{ args }}" ]; then \
        npm run lint; \
    else \
        npx eslint {{ args }}; \
    fi

eslint: lint

knip *args:
    npx knip --no-exit-code {{ args }}

# Run the full project audit without stopping on individual failures.
check:
    npm run typecheck || true; \
    npm run test -- --run || true; \
    npx knip --no-exit-code; \
    npm run lint || true

# ============== STYLE TOKENS LOG ==================

tokens *args:
    if [ -z "{{ args }}" ]; then \
        npx tsx src/styleTokens/compiler/dryLogCompiler.ts; \
    else \
        npx tsx src/styleTokens/compiler/dryLogCompiler.ts {{ args }}; \
    fi

# ==================== EXTENSIONS ====================

deploy-cvc:
    cd extensions/css-variable-completion && npm run deploy
    code --install-extension extensions/css-variable-completion/css-variable-completion-0.0.1.vsix

# ==================== WORKSPACE ====================

open:
    @echo "🤖 Opening workspace from WSL..."
    code {{ workspace }}

open-new:
    @echo "🤖 Opening workspace in a new window..."
    code -n {{ workspace }}


# ==================== HELP ====================

help:
    @echo ""
    @echo "==================== COMMAND SURFACE ===================="
    @echo ""
    @echo "[JUST] orchestration layer"
    @echo "→ just"
    @just --list
    @echo ""
    @echo "[NPM] package scripts"
    @echo "→ npm run"
    @npm pkg get scripts
