{
  "compilerOptions": {
    "paths": {
      "@api/*": ["./src/api/*"],
      "@app/*": ["./src/app/*"],
      "@assets/*": ["./src/assets/*"],
      "@config/*": ["./src/config/*"],
      "@data/*": ["./src/data/*"],
      "@features/*": ["./src/features/*"],
      "@interaction/*": ["./src/interaction/*"],
      "@primitives/*": ["./src/primitives/*"],
      "@composites/*": ["./src/composites/*"],

      "@stores/*": ["./src/shared/state/stores/*"],
      "@hooks/*": ["./src/shared/state/hooks/*"],
      "@typing/*": ["./src/shared/typing/*"],
      "@styles/*": ["./src/shared/styles/*"],
      "@utils/*": ["./src/shared/utils/*"],

      "@infrastructure/*": ["./src/infrastructure/*"],
      "@test/*": ["./src/test/*"]
