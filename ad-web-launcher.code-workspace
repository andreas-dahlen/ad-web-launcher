{
	"folders": [
		{
			"path": "."
		}
	],
	"settings": {
		"files.exclude": {
			"**/android": true,
			"**/archive": true,
			"**/ADWebWallpaper": true,
			"**/md": true,
			"**/dist": true,
			"**/node_modules": true,
		},
		"terminal.integrated.cwd": "${workspaceFolder}/web-react",
		"scopesManager.localScopes": [
			{
				"id": "msarlp1lgzu1f",
				"name": "src",
				"patterns": [
					"ad-web-launcher/web-react/src/**"
				]
			},
			{
				"id": "msaro3tcz6j9n",
				"name": "visuals",
				"patterns": [
					"ad-web-launcher/web-react/src/styleTokens/tokens/**",
					"ad-web-launcher/web-react/src/panels/**",
					"ad-web-launcher/web-react/src/features/**",
					"ad-web-launcher/web-react/src/composites/**",
					"ad-web-launcher/web-react/src/blocks/**",
					"ad-web-launcher/web-react/src/primitives/**"
				]
			},
			{
				"id": "msc05evzzsobo",
				"name": "compiler",
				"patterns": [
					"ad-web-launcher/web-react/src/styleTokens/**",
					"ad-web-launcher/web-react/src/shared/tokenUtils/**",
					"ad-web-launcher/web-react/src/shared/sxCompiler/**",
					"ad-web-launcher/web-react/eslint/**",
					"ad-web-launcher/web-react/src/test/**"
				]
			},
			{
				"id": "msi1k6fk2gsps",
				"name": "compiler tests",
				"patterns": [
					"ad-web-launcher/web-react/src/test/**",
					"ad-web-launcher/web-react/src/styleTokens/**"
				]
			}
		]
	}
}