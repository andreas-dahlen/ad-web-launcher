{
	"folders": [
		{
			"path": "."
		}
	],
	"settings": {

		"cssVariables.lookupFiles": [
			"**/*.less",
			"**/*.scss",
			"**/*.sass",
			"**/*.css",
			"**/*.html",
			"**/*.vue",
			"**/*.svelte",
			"**/*.astro",
			"**/*.ripple",
			"**/*.jsx",
			"**/*.tsx",
			"**/*.ts",
			"**/*.js",
		],
		"cssVariables.blacklistFolders": [
			"**/.cache/**",
			"**/.DS_Store",
			"**/.git/**",
			"**/.hg/**",
			"**/.next/**",
			"**/.svn/**",
			"**/bower_components/**",
			"**/CVS/**",
			"**/dist/**",
			"**/node_modules/**",
			"**/tmp/**",
			"**/tests/**",
			"**/test/**",
			"web-react/src/test/**",
			"**/web-react/src/test/**",
			// "**ad-web-launcher/web-react/src/test/**",
		],
		"files.exclude": {
			"**/android": true,
			"**/archive": true,
			"**/ADWebWallpaper": true,
			"**/md": true,
			"**/node_modules": true,
			"**/coverage*": true
		},
		"terminal.integrated.cwd": "${workspaceFolder}/web-react",
		"scopesManager.localScopes": [
			{
				"id": "msarlp1lgzu1f",
				"name": "app",
				"patterns": [
					"ad-web-launcher/web-react/ad-web-launcher/web-react/src/**"
				]
			},
			{
				"id": "mt6cwmpyqswqt",
				"name": "tools",
				"patterns": [
					"ad-web-launcher/web-react/ad-web-launcher/web-react/tools/**",
					"ad-web-launcher/web-react/ad-web-launcher/web-react/eslint.config.ts",
					"ad-web-launcher/web-react/ad-web-launcher/web-react/oxlint.config.ts"
				]
			}
		],
		"cssModulesIntellisense.diagnostics.classNotUsed.enabled": false
	}
}